
# Application
APP_ENV=development
APP_NAME=reliable-webhook-platform
APP_HOST=0.0.0.0
APP_PORT=8000

# Database - PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://webhook_user:webhook_pass@postgres:5432/webhook_db

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
# Set to true to run Celery tasks synchronously (useful for testing)
CELERY_TASK_ALWAYS_EAGER=false

# Outbox Dispatcher
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=50

# Delivery HTTP Timeouts (seconds)
DELIVERY_CONNECT_TIMEOUT_SECONDS=5
DELIVERY_READ_TIMEOUT_SECONDS=10

# Event Payload Size Limit (bytes)
MAX_EVENT_PAYLOAD_BYTES=1048576

# Demo tenant bootstrap
DEFAULT_TENANT_NAME=demo-tenant
# The DEMO_API_KEY env var is only read by the bootstrap script.
# It will be printed once on creation. Do NOT commit a real key.
# DEMO_API_KEY=  (leave empty to auto-generate)

# Security: Allow test-receiver URLs in development only
# Comma-separated list of hostnames allowed for destination URLs
# that would otherwise be blocked as private/internal addresses.
ALLOW_LOCAL_TEST_DESTINATIONS=test-receiver

# Logging
LOG_LEVEL=INFO

# ==============================================================================
# Phase 2: Resilience, Observability & Rate Limiting Configurations
# ==============================================================================

# Automatic Retries with Exponential Backoff
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=300.0
RETRY_JITTER_ENABLED=true

# Destination Rate Limiting (Token Bucket defaults)
DEFAULT_RATE_LIMIT_PER_SECOND=10.0
DEFAULT_RATE_LIMIT_BURST=20

# Destination Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OBSERVATION_WINDOW_SECONDS=60
CIRCUIT_BREAKER_OPEN_DURATION_SECONDS=60
CIRCUIT_BREAKER_HALF_OPEN_PROBES=2
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Observability
METRICS_ENABLED=true
